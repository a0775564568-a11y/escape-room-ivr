# העתיקו לקובץ .env.local (מקומי) או הגדירו ב-Vercel > Settings > Environment Variables.
# אין כאן ואין צורך בטוקן של ימות המשיח.

# שמירת התקדמות ב-Hugging Face Dataset (קובץ נפרד לכל משחק)
HF_TOKEN=
HF_DATASET=YOUR-USER/blackwood-saves

# סוד אופציונלי בין ימות המשיח לשרת. הוסיפו ?k=<הערך> לכתובת ה-api_link.
IVR_SECRET=

# tts (ברירת מחדל) או file (השמעת קבצים שהועלו לימות המשיח)
AUDIO_MODE=tts
